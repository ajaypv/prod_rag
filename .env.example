# Runtime
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_DATA_DIR=./data
RAG_ADMIN_API_KEY=replace-with-a-long-random-value
RAG_QUERY_API_KEY=replace-with-a-separate-long-random-value

# OCI native inference API: embeddings and reranking
OCI_REGION=us-chicago-1
OCI_SERVICE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_AUTH_TYPE=API_KEY
OCI_EMBED_MODEL=cohere.embed-v4.0
OCI_EMBED_DIMENSION=1536
OCI_RERANK_ENABLED=true
OCI_RERANK_MODEL=cohere.rerank-v4.0-fast

# OCI native inference API: grounded answer generation
OCI_CHAT_MODEL=openai.gpt-oss-120b

# Local infrastructure
QDRANT_URL=http://localhost:6333
# Set QDRANT_PATH for an embedded test index. It takes precedence over QDRANT_URL.
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION=technical_support_v1
QDRANT_HNSW_ENABLED=false
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_HNSW_EF_SEARCH=128
REDIS_URL=redis://localhost:6379/0

# Ingestion/retrieval tuning. Tune these with prodRAG evaluation data.
RAG_MAX_FILE_MB=25
RAG_PARENT_MAX_CHARS=12000
RAG_CHUNK_SIZE_TOKENS=450
RAG_SEMANTIC_THRESHOLD=0.72
RAG_RETRIEVAL_CANDIDATES=20
RAG_FINAL_CONTEXTS=5
RAG_MIN_RERANK_SCORE=0.15
RAG_CONFIDENCE_MEDIUM_THRESHOLD=0.35
RAG_CONFIDENCE_HIGH_THRESHOLD=0.75
RAG_CONTEXT_CHAR_BUDGET=30000
